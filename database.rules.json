{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": true,
        ".write": true,
        ".validate": "$code.length === 5",
        "h": { ".validate": "newData.hasChildren(['v']) || !newData.exists() || data.exists()" },
        "p": { "$id": { ".validate": "$id.length <= 12" } }
      }
    }
  }
}
